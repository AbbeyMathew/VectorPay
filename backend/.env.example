# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/vectorpay

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Where the React app runs in development (used for CORS).
CLIENT_ORIGIN=http://localhost:5173

# Set to true when the site is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Set to true when the API sits behind a reverse proxy (nginx, a PaaS, ...).
TRUST_PROXY=false

# Email for password-reset codes.
# Leave SMTP_HOST empty in development and the code is printed to the server console instead.
# MAIL_TRANSPORT=console forces that behaviour even in production (demo deployments only).
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VectorPay" <no-reply@vectorpay.test>

# Used by `npm run seed` (required when NODE_ENV=production).
ADMIN_PHONE=9000000000
ADMIN_EMAIL=admin@vectorpay.test
ADMIN_PASSWORD=
