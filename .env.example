# Used by docker-compose.yml. Copy to .env (never commit it).
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECURE=false

# Password-reset emails. Default prints the code to the backend log (fine for demos).
# For real email, set MAIL_TRANSPORT= (empty) and fill in the SMTP_* values.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
